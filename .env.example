# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Anthropic API key used by the discovery (LLM observe-decide-act) loop.
ANTHROPIC_API_KEY=

# Model identifier passed to the Anthropic SDK. Non-negotiable per CLAUDE.md:
# must be read from this env var, never hardcoded.
ANTHROPIC_MODEL=claude-sonnet-5

# Base URL of the local mock credit union portal (Flask + Jinja2).
MOCK_BANK_BASE_URL=http://localhost:5000

# Port the WebSocket handoff server listens on for pause/resume signaling.
WS_HANDOFF_PORT=8765

# Where discovery writes/reads versioned capability artifacts.
ARTIFACT_STORAGE_DIR=./artifacts

# Where run logs, screenshots, and traces are written per run.
EVIDENCE_DIR=./evidence

# Signs the mock bank's session cookies (server-wide, not per-user).
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
MOCK_BANK_SECRET_KEY=

# Copy this file to .env and fill in your own values.
# Never commit .env: it holds secrets, and .gitignore already excludes it.

# --- Claude API ---

# Your Anthropic API key. Only discovery uses it, when the model drives the browser.
ANTHROPIC_API_KEY=

# The Claude model that discovery uses.
ANTHROPIC_MODEL=claude-opus-5

# --- Mock bank ---

# The address where the mock bank runs. The agent is only allowed to act on this site.
MOCK_BANK_BASE_URL=http://localhost:5000

# What kind of bank the address above points to: "sandbox" (a test copy) or
# "production" (a live bank). In a sandbox, discovery may complete irreversible steps,
# such as confirming a payment, so it can record what happens after them. In
# production it never does. If this line is missing, the code assumes production.
# "sandbox" is accepted only for a bank running on this machine (localhost); for any
# other address, discovery refuses to start.
TARGET_ENVIRONMENT=sandbox

# The key the mock bank uses to sign its login sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MOCK_BANK_SECRET_KEY=

# The teller username the agent signs in with (the mock bank's demo user is admin).
MOCK_BANK_USERNAME=admin

# The teller password (the mock bank's demo password is admin123). Our code types it
# into the page; it is never shown to the model and never written to logs or artifacts.
MOCK_BANK_PASSWORD=

# --- Artifacts, evidence and handoff ---

# The key used to sign every saved artifact, so any later edit is detected.
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ARTIFACT_SIGNING_KEY=

# The folder where saved artifacts are stored.
ARTIFACT_STORAGE_DIR=./artifacts

# The folder where run logs and screenshots are written.
EVIDENCE_DIR=./evidence

# The port of the WebSocket server used for handing a run over to a person.
WS_HANDOFF_PORT=8765
